{
  "v": 1,
  "name": "Moqui A2A 1.0 JSON-RPC",
  "folders": [],
  "requests": [
    {
      "v": "1",
      "name": "01 Agent Card discovery (public)",
      "endpoint": "<<baseUrl>>/.well-known/agent-card.json",
      "method": "GET",
      "headers": [{ "key": "ngrok-skip-browser-warning", "value": "true", "active": true }],
      "params": [],
      "auth": { "authType": "none", "authActive": true },
      "body": { "contentType": null, "body": null },
      "preRequestScript": "",
      "testScript": "pw.test(\"card is served\", () => { pw.expect(pw.response.status).toBe(200); });\npw.test(\"advertises the JSON-RPC 1.0 interface at the public URL\", () => {\n  const itf = pw.response.body.supportedInterfaces[0];\n  pw.expect(itf.protocolBinding).toBe(\"JSONRPC\");\n  pw.expect(itf.protocolVersion).toBe(\"1.0\");\n  pw.expect(itf.url).toBe(pw.env.get(\"baseUrl\") + \"/llm/a2a/jsonrpc\");\n  pw.env.set(\"rpcUrl\", itf.url);\n});\npw.test(\"streaming on, push off, generic public skill\", () => {\n  pw.expect(pw.response.body.capabilities.streaming).toBe(true);\n  pw.expect(pw.response.body.capabilities.pushNotifications).toBe(false);\n  pw.expect(pw.response.body.skills[0].id).toBe(\"moqui-assist\");\n});"
    },
    {
      "v": "1",
      "name": "02 No credentials -> 401",
      "endpoint": "<<rpcUrl>>",
      "method": "POST",
      "headers": [{ "key": "A2A-Version", "value": "1.0", "active": true },
                  { "key": "ngrok-skip-browser-warning", "value": "true", "active": true }],
      "params": [],
      "auth": { "authType": "none", "authActive": true },
      "body": { "contentType": "application/json", "body": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"GetTask\",\"params\":{\"id\":\"x\"}}" },
      "preRequestScript": "",
      "testScript": "pw.test(\"auth filter rejects anonymous calls\", () => { pw.expect(pw.response.status).toBe(401); });"
    },
    {
      "v": "1",
      "name": "03 Missing A2A-Version -> -32009",
      "endpoint": "<<rpcUrl>>",
      "method": "POST",
      "headers": [{ "key": "ngrok-skip-browser-warning", "value": "true", "active": true }],
      "params": [],
      "auth": { "authType": "basic", "authActive": true, "username": "<<user>>", "password": "<<password>>" },
      "body": { "contentType": "application/json", "body": "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"GetTask\",\"params\":{\"id\":\"x\"}}" },
      "preRequestScript": "",
      "testScript": "pw.test(\"VersionNotSupportedError at HTTP 200\", () => {\n  pw.expect(pw.response.status).toBe(200);\n  pw.expect(pw.response.body.error.code).toBe(-32009);\n  pw.expect(pw.response.body.id).toBe(3);\n});"
    },
    {
      "v": "1",
      "name": "04 Legacy 0.3 method name -> -32601",
      "endpoint": "<<rpcUrl>>",
      "method": "POST",
      "headers": [{ "key": "A2A-Version", "value": "1.0", "active": true },
                  { "key": "ngrok-skip-browser-warning", "value": "true", "active": true }],
      "params": [],
      "auth": { "authType": "basic", "authActive": true, "username": "<<user>>", "password": "<<password>>" },
      "body": { "contentType": "application/json", "body": "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"message/send\",\"params\":{}}" },
      "preRequestScript": "",
      "testScript": "pw.test(\"MethodNotFound\", () => { pw.expect(pw.response.body.error.code).toBe(-32601); });"
    },
    {
      "v": "1",
      "name": "05 Batch request -> -32600",
      "endpoint": "<<rpcUrl>>",
      "method": "POST",
      "headers": [{ "key": "A2A-Version", "value": "1.0", "active": true },
                  { "key": "ngrok-skip-browser-warning", "value": "true", "active": true }],
      "params": [],
      "auth": { "authType": "basic", "authActive": true, "username": "<<user>>", "password": "<<password>>" },
      "body": { "contentType": "application/json", "body": "[{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"GetTask\",\"params\":{\"id\":\"x\"}}]" },
      "preRequestScript": "",
      "testScript": "pw.test(\"InvalidRequest, first element not executed\", () => {\n  pw.expect(pw.response.status).toBe(200);\n  pw.expect(pw.response.body.error.code).toBe(-32600);\n});"
    },
    {
      "v": "1",
      "name": "06 Unknown task -> -32001",
      "endpoint": "<<rpcUrl>>",
      "method": "POST",
      "headers": [{ "key": "A2A-Version", "value": "1.0", "active": true },
                  { "key": "ngrok-skip-browser-warning", "value": "true", "active": true }],
      "params": [],
      "auth": { "authType": "basic", "authActive": true, "username": "<<user>>", "password": "<<password>>" },
      "body": { "contentType": "application/json", "body": "{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"GetTask\",\"params\":{\"id\":\"no-such-task\"}}" },
      "preRequestScript": "",
      "testScript": "pw.test(\"TaskNotFoundError with ErrorInfo\", () => {\n  pw.expect(pw.response.body.error.code).toBe(-32001);\n  pw.expect(pw.response.body.error.data[0].reason).toBe(\"TASK_NOT_FOUND\");\n});"
    },
    {
      "v": "1",
      "name": "07 Push config -> -32003",
      "endpoint": "<<rpcUrl>>",
      "method": "POST",
      "headers": [{ "key": "A2A-Version", "value": "1.0", "active": true },
                  { "key": "ngrok-skip-browser-warning", "value": "true", "active": true }],
      "params": [],
      "auth": { "authType": "basic", "authActive": true, "username": "<<user>>", "password": "<<password>>" },
      "body": { "contentType": "application/json", "body": "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"CreateTaskPushNotificationConfig\",\"params\":{\"taskId\":\"x\",\"url\":\"https://example.invalid/hook\"}}" },
      "preRequestScript": "",
      "testScript": "pw.test(\"PushNotificationNotSupportedError\", () => { pw.expect(pw.response.body.error.code).toBe(-32003); });"
    },
    {
      "v": "1",
      "name": "08 GetExtendedAgentCard",
      "endpoint": "<<rpcUrl>>",
      "method": "POST",
      "headers": [{ "key": "A2A-Version", "value": "1.0", "active": true },
                  { "key": "ngrok-skip-browser-warning", "value": "true", "active": true }],
      "params": [],
      "auth": { "authType": "basic", "authActive": true, "username": "<<user>>", "password": "<<password>>" },
      "body": { "contentType": "application/json", "body": "{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"GetExtendedAgentCard\",\"params\":{}}" },
      "preRequestScript": "",
      "testScript": "pw.test(\"raw AgentCard with skills\", () => {\n  const card = pw.response.body.result;\n  pw.expect(card.supportedInterfaces[0].url).toBe(pw.env.get(\"rpcUrl\"));\n  pw.expect(card.skills.length > 0).toBe(true);\n});"
    },
    {
      "v": "1",
      "name": "09 SendMessage",
      "endpoint": "<<rpcUrl>>",
      "method": "POST",
      "headers": [{ "key": "A2A-Version", "value": "1.0", "active": true },
                  { "key": "ngrok-skip-browser-warning", "value": "true", "active": true }],
      "params": [],
      "auth": { "authType": "basic", "authActive": true, "username": "<<user>>", "password": "<<password>>" },
      "body": { "contentType": "application/json", "body": "{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"SendMessage\",\"params\":{\"message\":{\"messageId\":\"<<mid>>\",\"role\":\"ROLE_USER\",\"parts\":[{\"text\":\"Hello Moqui Agent, can you process this request?\"}]},\"configuration\":{\"historyLength\":10}}}" },
      "preRequestScript": "pw.env.set(\"mid\", \"hopp-\" + Date.now());",
      "testScript": "pw.test(\"JSON-RPC response for the same id\", () => {\n  pw.expect(pw.response.status).toBe(200);\n  pw.expect(pw.response.body.jsonrpc).toBe(\"2.0\");\n  pw.expect(pw.response.body.id).toBe(9);\n});\npw.test(\"either a SendMessageResponse {task} or an A2A error\", () => {\n  const b = pw.response.body;\n  if (b.result) { pw.expect(b.result.task.status.state).toBeType(\"string\"); }\n  else { pw.expect(b.error.code).toBeType(\"number\"); }\n});"
    },
    {
      "v": "1",
      "name": "10 SendStreamingMessage (SSE)",
      "endpoint": "<<rpcUrl>>",
      "method": "POST",
      "headers": [{ "key": "A2A-Version", "value": "1.0", "active": true },
                  { "key": "Accept", "value": "text/event-stream", "active": true },
                  { "key": "ngrok-skip-browser-warning", "value": "true", "active": true }],
      "params": [],
      "auth": { "authType": "basic", "authActive": true, "username": "<<user>>", "password": "<<password>>" },
      "body": { "contentType": "application/json", "body": "{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"SendStreamingMessage\",\"params\":{\"message\":{\"messageId\":\"<<mid>>-s\",\"role\":\"ROLE_USER\",\"parts\":[{\"text\":\"Hello Moqui Agent, stream the task events.\"}]}}}" },
      "preRequestScript": "pw.env.set(\"mid\", \"hopp-\" + Date.now());",
      "testScript": "const text = typeof pw.response.body === \"string\" ? pw.response.body : JSON.stringify(pw.response.body);\npw.test(\"text/event-stream with JSON-RPC data lines\", () => {\n  const ct = pw.response.headers.find(h => h.key.toLowerCase() === \"content-type\");\n  pw.expect(ct.value).toInclude(\"text/event-stream\");\n  pw.expect(text).toInclude(\"data: {\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":10\");\n});\npw.test(\"Task first, then WORKING, then a final state\", () => {\n  pw.expect(text).toInclude(\"TASK_STATE_SUBMITTED\");\n  pw.expect(text).toInclude(\"statusUpdate\");\n  pw.expect(text).toInclude(\"TASK_STATE_WORKING\");\n  pw.expect(/TASK_STATE_(COMPLETED|FAILED|INPUT_REQUIRED)/.test(text)).toBe(true);\n});"
    },
    {
      "v": "1",
      "name": "11 ListTasks",
      "endpoint": "<<rpcUrl>>",
      "method": "POST",
      "headers": [{ "key": "A2A-Version", "value": "1.0", "active": true },
                  { "key": "ngrok-skip-browser-warning", "value": "true", "active": true }],
      "params": [],
      "auth": { "authType": "basic", "authActive": true, "username": "<<user>>", "password": "<<password>>" },
      "body": { "contentType": "application/json", "body": "{\"jsonrpc\":\"2.0\",\"id\":11,\"method\":\"ListTasks\",\"params\":{\"pageSize\":5,\"historyLength\":0}}" },
      "preRequestScript": "",
      "testScript": "pw.test(\"ListTasksResponse envelope\", () => {\n  const r = pw.response.body.result;\n  pw.expect(r.tasks.length > 0).toBe(true);\n  pw.expect(r.nextPageToken).toBeType(\"string\");\n  pw.expect(r.pageSize).toBe(5);\n  pw.env.set(\"taskId\", r.tasks[0].id);\n});"
    },
    {
      "v": "1",
      "name": "12 GetTask (raw Task)",
      "endpoint": "<<rpcUrl>>",
      "method": "POST",
      "headers": [{ "key": "A2A-Version", "value": "1.0", "active": true },
                  { "key": "ngrok-skip-browser-warning", "value": "true", "active": true }],
      "params": [],
      "auth": { "authType": "basic", "authActive": true, "username": "<<user>>", "password": "<<password>>" },
      "body": { "contentType": "application/json", "body": "{\"jsonrpc\":\"2.0\",\"id\":12,\"method\":\"GetTask\",\"params\":{\"id\":\"<<taskId>>\",\"historyLength\":10}}" },
      "preRequestScript": "",
      "testScript": "pw.test(\"result is the Task itself\", () => {\n  const t = pw.response.body.result;\n  pw.expect(t.id).toBe(pw.env.get(\"taskId\"));\n  pw.expect(t.task).toBe(undefined);\n  pw.expect(t.history[0].role).toBe(\"ROLE_USER\");\n});"
    },
    {
      "v": "1",
      "name": "13 CancelTask on a terminal task -> -32002",
      "endpoint": "<<rpcUrl>>",
      "method": "POST",
      "headers": [{ "key": "A2A-Version", "value": "1.0", "active": true },
                  { "key": "ngrok-skip-browser-warning", "value": "true", "active": true }],
      "params": [],
      "auth": { "authType": "basic", "authActive": true, "username": "<<user>>", "password": "<<password>>" },
      "body": { "contentType": "application/json", "body": "{\"jsonrpc\":\"2.0\",\"id\":13,\"method\":\"CancelTask\",\"params\":{\"id\":\"<<taskId>>\"}}" },
      "preRequestScript": "",
      "testScript": "pw.test(\"TaskNotCancelableError\", () => { pw.expect(pw.response.body.error.code).toBe(-32002); });"
    },
    {
      "v": "1",
      "name": "14 SubscribeToTask on a terminal task -> -32004",
      "endpoint": "<<rpcUrl>>",
      "method": "POST",
      "headers": [{ "key": "A2A-Version", "value": "1.0", "active": true },
                  { "key": "Accept", "value": "text/event-stream", "active": true },
                  { "key": "ngrok-skip-browser-warning", "value": "true", "active": true }],
      "params": [],
      "auth": { "authType": "basic", "authActive": true, "username": "<<user>>", "password": "<<password>>" },
      "body": { "contentType": "application/json", "body": "{\"jsonrpc\":\"2.0\",\"id\":14,\"method\":\"SubscribeToTask\",\"params\":{\"id\":\"<<taskId>>\"}}" },
      "preRequestScript": "",
      "testScript": "const text = typeof pw.response.body === \"string\" ? pw.response.body : JSON.stringify(pw.response.body);\npw.test(\"UnsupportedOperationError as an SSE data line\", () => {\n  pw.expect(text).toInclude(\"-32004\");\n});"
    }
  ]
}
